@using Mover.Core.Dto
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using Mover.Core.Enums.Roles
@using Mover.HttpUtility
@{
    var currentUser = SessionInfo.GetCurrentUser();
    // var breadCrumbs = ViewData["BreadCrumbs"] == null ? new List<BreadcrumbDto>() : ViewData["BreadCrumbs"] as List<BreadcrumbDto>;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - DermShine</title>
    <link rel="icon" href="~/image/logo.jpg" type="image/jpg">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Owl Carousel -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Replace with toastr CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link href="~/css/bootstrap-toggle.css" rel="stylesheet" />
    <link href="~/css/homepage.css" rel="stylesheet" />

    <link href="~/css/DevExpressCss/dx.common.css" rel="stylesheet" />
    <link href="~/css/DevExpressCss/dx.light.css" rel="stylesheet" />

    <link href="~/css/jquery-confirm.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/23.1.6/css/dx.material.blue.light.css">


    <style>

    </style>

    @RenderSection("styles", false)
</head>
<body>

    <div class="top-bar">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-lg-2 col-md-12 text-center text-lg-start">
                    <a class="navbar-brand" href="/home/index">
                        <img src="/image/logo.jpg" alt="Derm Shine Logo" class="logo-img">
                    </a>
                </div>
                <div class="col-lg-7 col-md-12">
                    <div class="search-box">
                        <input type="text" class="form-control searchBarBox" id="searchInput" placeholder="Search for Derm Shine products">
                        <button class="search-btn searchbutton" id="searchButton">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>

                </div>
                <div class="col-lg-3 col-md-12 text-center text-lg-end">
                    <a href="/Cart/Index" class="cart-icon text-white me-3">
                        <i class="fas fa-shopping-cart"></i>
                    </a>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown d-inline-block">
                            <a href="#" class="login-btn btn-login dropdown-toggle" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle fa-lg"></i> @currentUser.FullName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="/Account/Profile"><i class="fas fa-user"></i> My Profile</a></li>
                                <li><a class="dropdown-item" href="/admin/order/index"><i class="fas fa-box"></i> My Orders</a></li>
                                <li><a class="dropdown-item" href="/Cart/Index"><i class="fas fa-shopping-cart"></i> My Cart</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="login-btn btn-login">LOGIN</a>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/home/index">HOME</a>
                    </li>
                    <li class="nav-item dropdown">


                        <a class="nav-link dropdown-toggle" href="#" id="shopDropdown" role="button" data-bs-toggle="dropdown">
                            SHOP
                        </a>
                        @await Component.InvokeAsync("Category")
                    </li>
                    @if (User.IsInRole(RolesEnum.Admin.ToString()))
                    {

                        <li class="nav-item">
                            <a class="nav-link" href="/account/index">USERS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/category/index">CATEGORY</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/product/index">PRODUCTS</a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="/cart/index">CARTS</a>
                    </li>
@*                     @if (User.Identity.IsAuthenticated)
                    { *@
                        <li class="nav-item">
                            <a class="nav-link" href="/admin/order/index">ORDER</a>
                        </li>
                    @* } *@
                    <li class="nav-item">
                        <a class="nav-link" href="/home/about">ABOUT</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/home/contact">CONTACT</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="body-content" id="cBody">
        <div class="container-fluid" style="margin:0px;padding:0px;">
            <div>
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="footer py-5">
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-12 col-md-6 col-lg-3">
                    <h5 class="footer-heading">About Us</h5>
                    <p class="text-muted">We are dedicated to providing the best shopping experience with our carefully selected products.</p>
                    <div class="social-links mt-3">
                        <a href="#" class="me-2"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="me-2"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="me-2"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <h5 class="footer-heading">Quick Links</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/home/index">Home</a></li>
                        <li><a href="/admin/product/viewproducts">Shop</a></li>
                        <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                        <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <h5 class="footer-heading">Customer Service</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/account/profile">My Account</a></li>
                        <li><a href="/admin/order/index">My Orders</a></li>
                        <li><a href="/cart/index">My Carts</a></li>
                        @* <li><a href="#">Terms & Conditions</a></li> *@
                    </ul>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <h5 class="footer-heading">Newsletter</h5>
                    <p class="text-muted">Subscribe to receive updates, access to exclusive deals, and more.</p>
                    <form class="mt-3">
                        <div class="input-group">
                            <input type="email" class="form-control" placeholder="Enter your email">
                            <button class="btn btn-primary" type="submit">Subscribe</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="footer-bottom py-3 border-top">
                <div class="row">
                    <div class="col-md-6 text-center text-md-start">
                        <p class="mb-0">&copy; @DateTime.Now.Year - Dermshine. All rights reserved.</p>
                    </div>
                    <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                        @* <img src="~/images/payment-methods.png" alt="Payment Methods" class="payment-methods" height="25"> *@
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Add this CSS to your existing style section -->
    <style>
        .footer {
            background-color: #f8f9fa;
            padding-top: 2rem;
            margin-top: auto;
        }

        .footer-heading {
            color: #333;
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1.2rem;
        }

        .footer-links li {
            margin-bottom: 0.8rem;
        }

        .footer-links a {
            color: #666;
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .footer-links a:hover {
                color: #0d6efd;
                text-decoration: none;
            }

        .social-links a {
            color: #666;
            font-size: 1.2rem;
            transition: color 0.3s ease;
        }

            .social-links a:hover {
                color: #0d6efd;
            }

        .footer-bottom {
            border-top: 1px solid #dee2e6;
            color: #666;
        }

        .payment-methods {
            height: 25px;
            object-fit: contain;
        }

        /* Make sure the footer stays at the bottom */
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .container {
            flex: 1 0 auto;
        }

        /* Newsletter form styling */
        .footer .form-control {
            border-radius: 4px 0 0 4px;
            border: 1px solid #dee2e6;
        }

        .footer .btn-primary {
            border-radius: 0 4px 4px 0;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .footer-bottom {
                text-align: center;
            }

            .payment-methods {
                margin-top: 1rem;
            }
        }
        /* Complete Responsive Design Overhaul */

        @@media (max-width: 991px) {
            .top-bar .row

        {
            flex-wrap: nowrap;
            align-items: center;
        }

        .top-bar .col-lg-2,
        .top-bar .col-lg-7,
        .top-bar .col-lg-3 {
            padding: 0 5px;
            flex: 0 0 auto;
        }

        .top-bar .col-lg-2 {
            width: 15%;
        }

        .top-bar .col-lg-7 {
            width: 60%;
        }

        .top-bar .col-lg-3 {
            width: 25%;
            text-align: right;
        }

        .logo-img {
            max-height: 40px;
            width: auto;
        }

        .search-box {
            display: flex;
        }

        .searchBarBox {
            height: 38px;
            font-size: 14px;
            padding: 0 10px;
        }

        .search-btn {
            height: 38px;
            width: 38px;
            padding: 0;
        }

        .cart-icon, .login-btn {
            margin-left: 5px;
            font-size: 14px;
            padding: 6px 10px;
        }

        /* Fix dropdown positioning */
        .dropdown-menu {
            right: 0;
            left: auto;
        }

        }

        /* Small screens */
        @@media (max-width: 767px) {
            .top-bar

        {
            padding: 8px 0;
        }

        .top-bar .col-lg-2 {
            width: 20%;
        }

        .top-bar .col-lg-7 {
            width: 50%;
        }

        .top-bar .col-lg-3 {
            width: 30%;
        }

        .logo-img {
            max-height: 35px;
        }

        .searchBarBox {
            height: 35px;
            font-size: 14px;
            padding: 0 8px;
        }

        .search-btn {
            height: 35px;
            width: 35px;
        }

        .cart-icon, .login-btn {
            margin-left: 5px;
            font-size: 14px;
            padding: 4px 8px;
        }

        /* Hide user name, show only icon */
        .dropdown-toggle::after {
            display: none;
        }

        .btn-login span {
            display: none;
        }

        }

        /* Extra small screens */
        @@media (max-width: 575px) {
            .top-bar

        {
            padding: 5px 0;
        }

        .top-bar .container {
            padding: 0 5px;
        }

        .top-bar .col-lg-2 {
            width: 15%;
        }

        .top-bar .col-lg-7 {
            width: 55%;
        }

        .top-bar .col-lg-3 {
            width: 30%;
        }

        .logo-img {
            max-height: 30px;
        }

        .searchBarBox {
            height: 30px;
            font-size: 12px;
            padding: 0 5px;
        }

        .search-btn {
            height: 30px;
            width: 30px;
        }

            .search-btn i {
                font-size: 12px;
            }

        .cart-icon, .login-btn {
            margin-left: 3px;
            font-size: 12px;
            padding: 3px 5px;
        }

            /* Optimize space for very small screens */
            .cart-icon .fa-shopping-cart,
            .login-btn .fa-user-circle {
                margin-right: 0;
            }

            /* Further reduce text where possible */
            .login-btn:not(.dropdown-toggle) {
                padding: 3px 6px;
                font-size: 11px;
            }

        }

        /* Additional CSS to ensure text doesn't break lines */
        @@media (max-width: 767px) {
            .login-btn

        {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }

        /* Fix dropdown menu position */
        .dropdown-menu {
            min-width: 200px;
            transform: translateX(30%);
        }

        }
        
    </style>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <!-- Include jQuery first -->


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdn3.devexpress.com/jslib/23.1.6/js/dx.all.js"></script>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/cldrjs/0.5.0/cldr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cldrjs/0.5.0/cldr-event.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cldrjs/0.5.0/cldr-datetime.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/globalize/1.7.0/globalize.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/globalize/1.7.0/globalize/message.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/globalize/1.7.0/globalize/number.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/globalize/1.7.0/globalize/currency.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/globalize/1.7.0/globalize/date.js"></script>



    <!-- Replace with toastr CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/respond.js"></script>
    <script src="~/js/bootbox.js"></script>
    <script src="~/js/select2.js"></script>
    <script src="~/js/designs.js"></script>
    <script src="~/js/bootstrap-select.min.js"></script>
    <script src="~/js/jquery.blockUI.js"></script>
    <script src="~/js/DevExpress/jszip.min.js"></script>
    <script src="~/js/DevExpress/dx.all.js"></script>
    <script src="~/js/DevExpress/exceljs.4.1.1.min.js"></script>
    <script src="~/js/DevExpress/FileSaver.2.0.2.min.js"></script>
    <script src="~/js/DevExpress/polyfill.7.4.0.min.js"></script>
    <script src="~/lib/fontawesome/js/all.min.js"></script>
    <script src="~/js/select2.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/tinymce/tinymce.min.js"></script>
    <script src="~/js/jquery-confirm.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#searchButton").click(function (event) {
                event.preventDefault(); // Prevent default anchor behavior

                let searchValue = $("#searchInput").val().trim(); // Get search input value
                console.log("Search Value:", searchValue);

                if (searchValue) {
                    let url = `/admin/product/ViewProducts?searchTerm=${encodeURIComponent(searchValue)}`;
                    window.location.href = url; // Redirect to the search URL
                }
            });
        });
    </script>

    @RenderSection("scripts", required: false)
    @await Html.PartialAsync("_NotificationPartial")
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>



