    <section class="about-us-section py-5">
        <div class="container">
            <h2 class="text-center section-title">ABOUT US</h2>

            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="about-us-card">
                        <div class="row align-items-center">

                            <div class="col-md-12 about-us-text-column">
                                <p>
                                    @Html.Raw(ViewBag.AboutUs)
                                </p>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center border-end">
                    <h3>Want something?</h3>
                    <a href="/admin/product/viewproducts" class="cta-btn mt-1">PLACE AN ORDER</a>
                </div>
                <div class="col-md-6 text-center">
                    <h3>Need help?</h3>
                    <a href="/home/contact" class="cta-btn mt-1">GET IN TOUCH</a>
                </div>
            </div>
        </div>
    </section>



    @section Scripts {

        <script>
                       $(document).ready(function(){
                           // Main Banner Carousel
                           $('.main-banner').owlCarousel({
                               items: 1,
                               loop: true,
                               nav: false,
                               dots: false,
                               autoplay: true,
                               autoplayTimeout: 5000,
                               onInitialized: customIndicators,
                               onTranslated: customIndicators
                           });

                           // Custom Carousel Indicators
                           function customIndicators(event) {
                               var element = event.target; // DOM element
                               var items = event.item.count; // Number of items
                               var item = event.item.index; // Current item index

                               // Remove all existing indicators
                               $('.custom-carousel-indicators').empty();

                               // Add new indicators
                               for (var i = 0; i < items; i++) {
                                   var className = (i === item) ? 'owl-dot active' : 'owl-dot';
                                   $('.custom-carousel-indicators').append('<button class="' + className + '" data-owl-target="' + i + '"></button>');
                               }

                               // Click event for indicators
                               $('.custom-carousel-indicators .owl-dot').click(function() {
                                   var index = $(this).data('owl-target');
                                   $('.main-banner').trigger('to.owl.carousel', index);
                               });
                           }

                           // Shop by Category Carousel
                           $('.category-section .owl-carousel').owlCarousel({
                               items: 4,
                               loop: true,
                               nav: true,
                               dots: true,
                               autoplay: true,
                               autoplayTimeout: 5000,
                               responsive: {
                                   0: {
                                       items: 1
                                   },
                                   768: {
                                       items: 2
                                   },
                                   992: {
                                       items: 4
                                   }
                               }
                           });
                       });

                       $(document).ready(function(){
                           var categoryCount = @ViewBag.Categories.Count;

                           $('.category-carousel').owlCarousel({
                               loop: categoryCount > 4,
                               margin: 20,
                               nav: true,
                               dots: true,
                               autoplay: categoryCount > 4,
                               autoplayTimeout: 5000,
                               autoplayHoverPause: true,
                               navText: [
                                   "<i class='fas fa-chevron-left'></i>",
                                   "<i class='fas fa-chevron-right'></i>"
                               ],
                               responsive: {
                                   0: {
                                       items: 1
                                   },
                                   576: {
                                       items: 2
                                   },
                                   768: {
                                       items: 3
                                   },
                                   992: {
                                       items: 4
                                   }
                               }
                           });
                       });



                       $(document).ready(function () {
                           $("#searchButton").click(function (event) {
                               event.preventDefault(); // Prevent default anchor behavior

                               let searchValue = $("#searchInput").val().trim(); // Get search input value
                               console.log("Search Value:", searchValue);

                               if (searchValue) {
                                   let url = `/admin/product/ViewProducts?searchTerm=${encodeURIComponent(searchValue)}`;
                                   window.location.href = url; // Redirect to the search URL
                               }
                           });


                        $('.addToCart').on('click', function () {
                           var button = $(this);
                           var productId = button.data('product-id');
                           var productName = button.data('product-name');
                           var discountedPrice = button.data('discounted-price');

                           var cartData = {
                               ProductId: productId,
                               ProductName: productName,
                               Quantity: 1,
                               TotalPrice: discountedPrice
                           };

                           $.ajax({
                               type: "POST",
                               url: '@Url.Action("AddToCart", "Home")',
                               data: cartData,
                               headers: {
                                   'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() // For AntiForgery
                               },
                               success: function () {
                                   toastr.success('Product added to cart successfully!');
                                   // optionally: update cart count badge
                               },
                               error: function () {
                                   toastr.error('Failed to add product to cart. Please try again.');
                               }
                           });
                       });
                       });





        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    }
</body>