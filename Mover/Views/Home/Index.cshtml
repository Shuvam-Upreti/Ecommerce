    @section Scripts {

        <script>
            $(document).ready(function(){
                // Main Banner Carousel
                $('.main-banner').owlCarousel({
                    items: 1,
                    loop: true,
                    nav: false,
                    dots: false,
                    autoplay: true,
                    autoplayTimeout: 5000,
                    onInitialized: customIndicators,
                    onTranslated: customIndicators
                });

                // Custom Carousel Indicators
                function customIndicators(event) {
                    var element = event.target; // DOM element
                    var items = event.item.count; // Number of items
                    var item = event.item.index; // Current item index

                    // Remove all existing indicators
                    $('.custom-carousel-indicators').empty();

                    // Add new indicators
                    for (var i = 0; i < items; i++) {
                        var className = (i === item) ? 'owl-dot active' : 'owl-dot';
                        $('.custom-carousel-indicators').append('<button class="' + className + '" data-owl-target="' + i + '"></button>');
                    }

                    // Click event for indicators
                    $('.custom-carousel-indicators .owl-dot').click(function() {
                        var index = $(this).data('owl-target');
                        $('.main-banner').trigger('to.owl.carousel', index);
                    });
                }

                // Shop by Category Carousel
                $('.category-section .owl-carousel').owlCarousel({
                    items: 4,
                    loop: true,
                    nav: true,
                    dots: true,
                    autoplay: true,
                    autoplayTimeout: 5000,
                    responsive: {
                        0: {
                            items: 1
                        },
                        768: {
                            items: 2
                        },
                        992: {
                            items: 4
                        }
                    }
                });
            });

            $(document).ready(function(){
                var categoryCount = @ViewBag.Categories.Count;

                $('.category-carousel').owlCarousel({
                    loop: categoryCount > 4,
                    margin: 20,
                    nav: true,
                    dots: true,
                    autoplay: categoryCount > 4,
                    autoplayTimeout: 5000,
                    autoplayHoverPause: true,
                    navText: [
                        "<i class='fas fa-chevron-left'></i>",
                        "<i class='fas fa-chevron-right'></i>"
                    ],
                    responsive: {
                        0: {
                            items: 1
                        },
                        576: {
                            items: 2
                        },
                        768: {
                            items: 3
                        },
                        992: {
                            items: 4
                        }
                    }
                });
            });



            $(document).ready(function () {
                $("#searchButton").click(function (event) {
                    event.preventDefault(); // Prevent default anchor behavior

                    let searchValue = $("#searchInput").val().trim(); // Get search input value
                    console.log("Search Value:", searchValue);

                    if (searchValue) {
                        let url = `/admin/product/ViewProducts?searchTerm=${encodeURIComponent(searchValue)}`;
                        window.location.href = url; // Redirect to the search URL
                    }
                });
            });


        </script>
    }
</body>
