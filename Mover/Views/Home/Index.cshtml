                        </div>
                        <div class="stats-content mt-2">
                            <div class="stats-number fw-bold">Upto 10%</div>
                            <div class="stats-label">DISCOUNTS</div>
                        </div>
                    </div>
                </div>

                <!-- Fourth stat item -->
                <div class="col-12 col-sm-6 col-md-3 mb-3 mb-md-0">
                    <div class="stats-item text-center">
                        <div class="stats-circle mx-auto">
                            <i class="fa-solid fa-box" style="color:#0eccb3;"></i>
                        </div>
                        <div class="stats-content mt-2">
                            <div class="stats-number fw-bold">10+</div>
                            <div class="stats-label">ACTIVE PRODUCTS</div>
                        </div>
