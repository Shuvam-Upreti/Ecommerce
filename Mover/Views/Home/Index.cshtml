    <section class="product-section py-5">
        <div class="container text-center">
            <h2 class="text-center mb-5 section-title">OUR PRODUCTS</h2>

            <div class="row g-4">
                @foreach (var product in Model)
                {
                    <!-- Product -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="product-card position-relative">
                            @if (product.InStock <= 0)
                            {
                                <span class="badge-stock">Out of Stock</span>
                            }
                            <div class="product-image-container">
                                <img src="@Url.Content($"~/{product.ImageUrls.FirstOrDefault()}")" alt="FH Secret Perfume" class="product-img">
                            </div>
                            <div class="product-content">
                                <h2 class="product-title">@product.ProductName</h2>
                                <div class="product-price">Rs. @product.DiscountedPrice <s class="product-original-price">Rs. @product.OriginalPrice</s></div>

                                <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-cart btn-outline-dark">
                                    <i class="fas fa-eye"></i> VIEW DETAILS
                                </a>

                            </div>
                        </div>
                    </div>
                }




                @*  <div class="col-12 col-sm-6 col-lg-3">
                    <div class="product-card position-relative">
                        <span class="badge-new">New</span>
                        <span class="badge-stock">Out of Stock</span>
                        <div class="product-image-container">
                            <img src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/image-ka5DbWYfTzjZIQn3OxHbK0SQ3cv4wL.png" alt="FH Secret Perfume" class="product-img">
                        </div>
                        <div class="product-content">
                            <h2 class="product-title">FH Secret Unisex Perfume - 100ml</h2>
                            <div class="product-price">Rs. 4999</div>
                            <button class="btn btn-cart disabled" disabled>
                                <i class="fas fa-shopping-cart"></i> ADD TO CART
                            </button>
                        </div>
                    </div>
                </div>*@
            </div>
        </div>
        <br />
        <br />
        <div class="all-products-btn d-flex justify-content-center">
            <button class="btn btn-allproducts">
                BROWSE ALL PRODUCTS
            </button>
        </div>
    </section>


    <!-- Stats Section -->
    <section class="stat-section py-5">
        <div class="container">
            <div class="row justify-content-center align-items-center">
                <div class="col-md-3 mb-3 mb-md-0">
                    <div class="stats-item">
                        <div class="stats-circle">
                            <i class="fa-solid fa-users" style="color:#0eccb3;"></i>
                        </div>
                        <div class="stats-content">
                            <div class="stats-number">150+</div>
                            <div class="stats-label">Consumers</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <div class="stats-item">
                        <div class="stats-circle">
                            <i class="fa-solid fa-truck-fast" style="color:#0eccb3;"></i>
                        </div>
                        <div class="stats-content">
                            <div class="stats-number">Within 24 Hr</div>
                            <div class="stats-label">Delivery</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <div class="stats-item">
                        <div class="stats-circle">
