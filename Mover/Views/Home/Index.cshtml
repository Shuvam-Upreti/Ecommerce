    <!-- Stats Section -->
    <section class="stat-section py-5">
        <div class="container">
            <div class="row justify-content-center align-items-center">
                <!-- First stat item -->
                <div class="col-12 col-sm-6 col-md-3 mb-3 mb-md-0">
                    <div class="stats-item text-center">
                        <div class="stats-circle mx-auto">
                            <i class="fa-solid fa-users" style="color:#0eccb3;"></i>
                        </div>
                        <div class="stats-content mt-2">
                            <div class="stats-number fw-bold">150+</div>
                            <div class="stats-label">CONSUMERS</div>
                        </div>
                    </div>
                </div>

                <!-- Second stat item -->
                <div class="col-12 col-sm-6 col-md-3 mb-3 mb-md-0">
                    <div class="stats-item text-center">
                        <div class="stats-circle mx-auto">
                            <i class="fa-solid fa-truck-fast" style="color:#0eccb3;"></i>
                        </div>
                        <div class="stats-content mt-2">
                            <div class="stats-number fw-bold">Within 24 Hr</div>
                            <div class="stats-label">DELIVERY</div>
                        </div>
                    </div>
                </div>

                <!-- Third stat item -->
                <div class="col-12 col-sm-6 col-md-3 mb-3 mb-md-0">
