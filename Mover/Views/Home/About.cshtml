@using Mover.ViewModel.Appsetting
@model AboutUsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "About Us";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - Modern Design</title>

    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <!-- Boxicons for modern icons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", sans-serif;
        }

        body {
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
            background-color: #f8f9fa;
        }

        .header {
            background: linear-gradient(135deg, #0eccb3 0%, #48cae4 100%);
            color: white;
            padding: 120px 0 160px;
            position: relative;
            overflow: hidden;
        }

            .header::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 100px;
                background: #f8f9fa;
                clip-path: polygon(0 50%, 100% 0, 100% 100%, 0% 100%);
            }

        .stats-section {
            margin-top: -80px;
            position: relative;
            z-index: 1;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            transition: transform 0.3s ease;
        }

            .stat-card:hover {
                transform: translateY(-5px);
            }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #0eccb3;
            margin-bottom: 10px;
        }

        .core-values {
            margin: 80px 0;
        }

        .value-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
            border-top: 4px solid #0eccb3;
        }

            .value-card:hover {
                transform: translateY(-5px);
            }

        .value-icon {
            font-size: 2.5rem;
            color: #0eccb3;
            margin-bottom: 20px;
        }

        .journey-timeline {
            position: relative;
            padding: 40px 0;
        }

        .timeline-item {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            position: relative;
            border-left: 4px solid #0eccb3;
        }

        .timeline-year {
            background: #0eccb3;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            display: inline-block;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .cta-section {
            background: linear-gradient(135deg, #0eccb3 0%, #48cae4 100%);
            padding: 80px 0;
            color: white;
            text-align: center;
            border-radius: 15px;
            margin: 60px 0;
        }

        .btn-modern {
            background-color: white;
            color: #0eccb3;
            padding: 12px 30px;
            border: none;
            border-radius: 30px;
            text-decoration: none;
            display: inline-block;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

            .btn-modern:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.2);
                color: #0eccb3;
            }

        @@media (max-width: 768px) {
            .header {
                padding: 80px 0 120px;
            }

            .stat-card {
                margin-bottom: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Header Section -->
    <div class="header">
        <div class="container text-center">
            <h1 class="display-4 fw-bold mb-4" data-aos="fade-up">About DermShine</h1>
            <p class="lead mb-0" data-aos="fade-up" data-aos-delay="100">@Model.AboutUs</p>
        </div>
    </div>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="row">
                <div class="col-md-3" data-aos="fade-up" data-aos-delay="100">
                    <div class="stat-card">
                        <div class="stat-number">@Model.HappyClients</div>
                        <div class="stat-label">Happy Clients</div>
                    </div>
                </div>
                <div class="col-md-3" data-aos="fade-up" data-aos-delay="200">
                    <div class="stat-card">
                        <div class="stat-number">@Model.ProductCount</div>
                        <div class="stat-label">Products</div>
                    </div>
                </div>
                <div class="col-md-3" data-aos="fade-up" data-aos-delay="300">
                    <div class="stat-card">
                        <div class="stat-number">@Model.DiscountPercentage</div>
                        <div class="stat-label">Discounts</div>
                    </div>
                </div>
                <div class="col-md-3" data-aos="fade-up" data-aos-delay="400">
                    <div class="stat-card">
                        <div class="stat-number">@Model.SupportAvailability</div>
                        <div class="stat-label">Support</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Values Section -->
    <section class="core-values">
        <div class="container">
            <h2 class="text-center mb-5" data-aos="fade-up">Our Core Values</h2>
            <div class="row">
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="value-card">
                        <i class='bx bx-bulb value-icon'></i>
                        <h3>Innovation</h3>
                        <p>
                            @Model.CoreValueInnovation.
                        </p>
                    </div>
                </div>
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="value-card">
                        <i class='bx bx-shield-quarter value-icon'></i>
                        <h3>Quality</h3>
                        <p>@Model.CoreValueQuality.</p>
                    </div>
                </div>
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                    <div class="value-card">
                        <i class='bx bx-heart value-icon'></i>
                        <h3>Care</h3>
                        <p>
                            @Model.CoreValueCare.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Journey Timeline Section -->
    <section class="journey-timeline">
        <div class="container">
            <h2 class="text-center mb-5" data-aos="fade-up">Our Journey</h2>
            <div class="row">
                <div class="col-md-12 offset-md-3 full-width" style="justify-content: center;margin-left:0px;">
                    <div class="timeline-item" data-aos="fade-up">
                        <span class="timeline-year">2020</span>
                        <h3>Company Founded</h3>
                        <p>Started with a vision to revolutionize health and wellness solutions.</p>
                    </div>
                    <div class="timeline-item" data-aos="fade-up">
                        <span class="timeline-year">2021</span>
                        <h3>Global Expansion</h3>
                        <p>Expanded our operations to 15+ countries worldwide.</p>
                    </div>
                    <div class="timeline-item" data-aos="fade-up">
                        <span class="timeline-year">2022</span>
                        <h3>Innovation Award</h3>
                        <p>Recognized for breakthrough developments in wellness technology.</p>
                    </div>
                    <div class="timeline-item" data-aos="fade-up">
                        <span class="timeline-year">2023</span>
                        <h3>Sustainability Initiative</h3>
                        <p>Launched eco-friendly product line and green manufacturing processes.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="container">
        <div class="cta-section" data-aos="fade-up">
            <h2 class="mb-4">Ready to Experience the Difference?</h2>
            <p class="mb-4">Join thousands of satisfied customers who trust DermShine for their wellness journey.</p>
            <a href="/admin/product/viewproducts" class="btn-modern">Shop Today</a>
        </div>
    </section>


    <!-- AOS Animation Library -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 1000,
            once: true,
            offset: 100
        });
    </script>
</body>

