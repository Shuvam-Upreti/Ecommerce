@using Mover.ViewModel.User
@model UserDetailViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "User Profile";
}

<style>
    :root {
        --primary-color: #0ca98f;
        --text-color: #333;
        --background-light: #F9FAFC;
        --border-color: black;
        --input-bg: #FFFFFF;
        --shadow-color: rgba(0, 0, 0, 0.05);
    }

    body {
        background-color: var(--background-light);
        font-family: 'Arial', sans-serif;
        color: var(--text-color);
    }

    .profile-container {
        max-width: 700px;
        margin: 50px auto;
        padding: 30px;
        background: white;
        border-radius: 8px;
        box-shadow: 0px 2px 8px var(--shadow-color);
        border: 1px solid var(--border-color);
        text-align: center;
    }

    .profile-header {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding-bottom: 8px;
        border-bottom: 3px solid var(--primary-color);
    }

    .profile-info {
        margin: 15px 0;
        font-size: 1.2rem;
        font-weight: 500;
    }

    .profile-label {
        font-weight: bold;
        color: var(--primary-color);
    }

    .btn-edit {
        background: var(--primary-color);
        color: white;
        font-size: 1rem;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.3s ease-in-out;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: #0a8e76;
        }
</style>

<div class="container profile-container">
    <input type="hidden" asp-for="Id" value="@Model.Id" />
    <div class="profile-header">User Profile</div>

    <div class="profile-info">
        <span class="profile-label">Full Name:</span> @Model.FullName
    </div>
    <div class="profile-info">
        <span class="profile-label">Email:</span> @Model.Email
    </div>
    <div class="profile-info">
        <span class="profile-label">Phone Number:</span> @Model.PhoneNumber
    </div>

    <div class="mt-4">
        <a class="btn btn-edit" id="editProfileBtn">Edit Profile</a>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-3">Back</a>
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editProfileForm">
                    <input type="hidden" id="userIdHidden" value="@Model.Id">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" class="form-control" id="fullName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input type="text" class="form-control" id="phoneNumber" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-edit" id="saveProfileBtn">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            // Show modal with existing values
            $("#editProfileBtn").click(function () {
                $("#fullName").val("@Model.FullName");
                $("#email").val("@Model.Email");
                $("#phoneNumber").val("@Model.PhoneNumber");
                $("#editProfileModal").modal("show");
            });

            // Save profile changes
            $("#saveProfileBtn").click(function () {
                var userId = $("#userIdHidden").val();
                var fullName = $("#fullName").val();
                var email = $("#email").val();
                var phone = $("#phoneNumber").val();

                // Check if any fields are empty
                if (!fullName || !email || !phone) {
                    Swal.fire("Error", "All fields are required.", "error");
                    return;
                }

                // Send data to server
                $.ajax({
                    url: "/Account/UpdateProfile",
                    type: "POST",
                    data: JSON.stringify({ Id: userId, FullName: fullName, Email: email, PhoneNumber: phone }),
                    contentType: "application/json",
                    success: function (response) {
                        if (response.success) {
                            $("#displayFullName").text(fullName);
                            $("#displayEmail").text(email);
                            $("#displayPhone").text(phone);
                             Swal.fire("Success", "Profile updated successfully!", "success").then(function() {
                                location.reload();
                             });
                            $("#editProfileModal").modal("hide");
                        } else {
                            Swal.fire("Error", response.message, "error");
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Something went wrong. Please try again.", "error");
                    }
                });
            });
        });
    </script>
}
