@using Mover.ViewModel.Account
@model LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Log in";
}

<div class="login-container">
    <div class="login-form-container">
        <h1>Log in</h1>
        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, true, new { @class = "login-form" }))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                @Html.TextBoxFor(m => m.Username, new { placeholder = "Username", @class = "form-control" })
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Username)</span>
            </div>
            <div class="form-group">
                @Html.PasswordFor(m => m.Password, new { placeholder = "Password", @class = "form-control" })
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Password)</span>
            </div>
            <div class="form-group">
                <input type="submit" class="btn btn-primary btn-block" value="Login" />
            </div>
            <div class="form-group text-center">
                <a href="/Account/ForgotPassword" class="forgot-password">Forgot Password?</a>
            </div>
            <div class="form-group text-danger">
                @Html.ValidationSummary(true)
            </div>
        }
    </div>
    @* <div class="login-info-container"> *@
    @*     <h3>A Complete Delivery Solution</h3> *@
    @* </div> *@
</div>

<script>
    $(document).ready(function () {
        let url = window.location.href;
        let indexOfFirstQuery = url.indexOf('?');
        let urlHasQueryString = indexOfFirstQuery != -1;

        if (urlHasQueryString) {
            let allQueryString = url.substring(indexOfFirstQuery + 1);
            let returnUrl = allQueryString.replace("ReturnUrl=", "");
            $('#return-url-input').val(returnUrl);
        }
    });
</script>
<script src="~/js/login/login.js" asp-append-version="true"></script>
