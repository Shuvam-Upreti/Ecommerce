@using Mover.ViewModel.Account
@model LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Log in";
}
<style>
    /* Hide the default number input arrows */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield; /* Hide arrows in Firefox */
    }

    /* Media Queries for Responsive Design */
    @@media (max-width: 768px) {
        .container

    {
        margin-top: 60px;
        min-height: 500px;
        transition: all 0.5s ease;
    }

    .form-box.login,
    .form-box.register {
        width: 100%;
        padding: 15px;
        transition: all 0.5s ease;
    }

    .toggle-box {
        display: none;
    }

    .container.active .form-box.register {
        transform: translateX(0);
        opacity: 1;
        z-index: 5;
        transition: all 0.5s ease;
    }

    }

    @@media (max-width: 480px) {
        .container

    {
        margin-top: 50px;
        width: 300px;
        min-height: 450px;
        transition: all 0.5s ease;
    }

        .form-box.login,
        .form-box.register {
            width: 100%;
            padding: 15px;
            transition: all 0.5s ease;
        }

        .toggle-box {
            display: none;
        }

        .container.active .form-box.register {
            transform: translateX(0);
            opacity: 1;
            z-index: 5;
            transition: all 0.5s ease;
        }

    .form-box {
        padding: 10px;
    }

    h1 {
        font-size: 24px;
    }

    .input-box input {
        padding: 10px 15px;
    }

    .btn {
        padding: 10px 25px;
    }

    }

    /* Touch Device Optimization */
    @@media (hover: none) and (pointer: coarse) {
        .btn

    {
        padding: 15px 30px;
    }

    .input-box input {
        padding: 15px 20px;
    }

    }

    /* Reduced Motion */
    @@media (prefers-reduced-motion: reduce) {
        .form-box, .toggle-box, .toggle-panel

    {
        transition: none;
    }

    }
</style>

<div class="container">
    <div class="form-box login">
        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, true, new { @class = "login-form" }))
        {
            @Html.AntiForgeryToken()
            <h1>Login</h1>
            <div class="input-box" style="width:100%">
                @Html.TextBoxFor(m => m.Username, new { placeholder = "Username", @class = "form-control", style = "width: 100%;" })
                <i class='bx bxs-user'></i>
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Username)</span>
            </div>
            <div class="input-box">
                @Html.PasswordFor(m => m.Password, new { placeholder = "Password", @class = "form-control", style = "width: 100%;" })
                <i class='bx bxs-lock-alt'></i>
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Password)</span>
            </div>
            <button type="submit" class="btn">Login</button>
            <div class="form-group text-danger">
                @Html.ValidationSummary(true)
            </div>
        }
    </div>

    <div class="form-box register">
        @using (Html.BeginForm("Create", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, true, new { @class = "registration-form", id = "registerForm" }))
        {
            <h1>Registration</h1>
            <div class="input-box">
                <input type="text" id="FullName" name="FullName" placeholder="Full Name" required>
                <i class='bx bxs-user'></i>
            </div>
            <div class="input-box">
                <input type="email" id="Email" name="Email" placeholder="Email" required>
                <i class='bx bxs-envelope'></i>
            </div>
            <div class="input-box">
                <input type="password" id="Password" name="Password" placeholder="Password" required>
                <i class='bx bxs-lock-alt'></i>
            </div>
            <div class="input-box">
                <input type="text" id="phoneInput" name="PhoneNumber" placeholder="Phone Number" required maxlength="10">
                <i class='bx bxs-phone'></i>
            </div>
            <button type="submit" class="btn">Register</button>
        }
    </div>

    <div class="toggle-box">
        <div class="toggle-panel toggle-left">
            <h1>Hello, Welcome!</h1>
            <p>Don't have an account?</p>
            <button class="btn register-btn">Register</button>
        </div>
        <div class="toggle-panel toggle-right">
            <h1>Welcome Back!</h1>
            <p>Already have an account?</p>
            <button class="btn login-btn">Login</button>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        let url = window.location.href;
        let indexOfFirstQuery = url.indexOf('?');
        let urlHasQueryString = indexOfFirstQuery != -1;

        if (urlHasQueryString) {
            let allQueryString = url.substring(indexOfFirstQuery + 1);
            let returnUrl = allQueryString.replace("ReturnUrl=", "");
            $('#return-url-input').val(returnUrl);
        }

        $("#registerForm").submit(function (event) {
            event.preventDefault();

            var formData = {
                FullName: $("#FullName").val(),
                Email: $("#Email").val(),
                Password: $("#Password").val(),
                ConfirmPassword: $("#Password").val(),
                PhoneNumber: $("#phoneInput").val()
            };

            $.ajax({
                type: "POST",
                url: "/Account/CreateAjax",
                data: formData,
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                        window.location.href = '/account/login';
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Error response:", xhr.responseText);
                    var errorMessage = xhr.responseText || "An error occurred while processing your request.";
                    toastr.error(errorMessage);
                }
            });
        });

        const container = document.querySelector('.container');
        const registerBtn = document.querySelector('.register-btn');
        const loginBtn = document.querySelector('.login-btn');

        registerBtn.addEventListener('click', () => {
            container.classList.add('active');
        });

        loginBtn.addEventListener('click', () => {
            container.classList.remove('active');
        });

        document.getElementById("phoneInput").addEventListener("input", function (e) {
            this.value = this.value.replace(/[^1234567890]/g, '');
        });
    });
</script>