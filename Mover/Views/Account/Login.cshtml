    @@media (max-width: 768px) {
        .container

    {
        flex-direction: column;
        align-items: center;
        padding: 20px 10px;
    }

    .form-box {
        width: 95%;
        max-width: 360px;
        padding: 20px;
    }

    .input-box input, .btn {
        font-size: 14px;
        padding: 10px;
    }

    .toggle-box {
        width: 95%;
        max-width: 360px;
        margin-top: 20px;
        flex-direction: column;
    }

    .toggle-panel {
        width: 100%;
        margin: 10px 0;
    }

    }

    @@media (max-width: 480px) {
        .form-box

    {
        width: 98%;
        max-width: 320px;
        margin: 5px;
        padding: 15px;
    }

    .input-box input, .btn {
        font-size: 12px;
        padding: 8px;
    }

    .toggle-panel {
        padding: 12px;
    }

    }

    @@media (max-width: 320px) {
        .form-box

    {
        width: 98%;
        max-width: 280px;
        padding: 10px;
    }

    .input-box input, .btn {
        font-size: 11px;
        padding: 7px;
    }

    }
   
</style>



<div class="container">

    <div class="form-box login">

        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, true, new { @class = "login-form" }))
        {
            @Html.AntiForgeryToken()

            <h1>Login</h1>

            <div class="input-box" style="width:100%">
                @Html.TextBoxFor(m => m.Username, new { placeholder = "Username", @class = "form-control", style = "width: 100%;" })
                <i class='bx bxs-user'></i>
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Username)</span>
            </div>

            <div class="input-box">
                @Html.PasswordFor(m => m.Password, new { placeholder = "Password", @class = "form-control", style = "width: 100%;" })
                <i class='bx bxs-lock-alt'></i>
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Password)</span>
            </div>

          @*   <div class="forgot-link">
                <a href="/Account/ForgotPassword">Forgot Password?</a>
            </div>
 *@
            <button type="submit" class="btn">Login</button>

            <div class="form-group text-danger">
                @Html.ValidationSummary(true)
            </div>
        }
    </div>

    <div class="form-box register">
        @using (Html.BeginForm("Create", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, true, new { @class = "registration-form", id = "registerForm" }))
        {
            <h1>Registration</h1>
            <div class="input-box">
                <input type="text" id="FullName" name="FullName" placeholder="Full Name" required>
                <i class='bx bxs-user'></i>
            </div>
            <div class="input-box">
                <input type="email" id="Email" name="Email" placeholder="Email" required>
                <i class='bx bxs-envelope'></i>
            </div>
            <div class="input-box">
                <input type="password" id="Password" name="Password" placeholder="Password" required>
                <i class='bx bxs-lock-alt'></i>
            </div>
            <div class="input-box">
                <input type="text" id="phoneInput" name="PhoneNumber" placeholder="Phone Number" required maxlength="10">
                <i class='bx bxs-phone'></i>
            </div>
            <button type="submit" class="btn">Register</button>
        }
    </div>


    <div class="toggle-box">
        <div class="toggle-panel toggle-left">
            <h1>Hello, Welcome!</h1>
            <p>Don't have an account?</p>
            <button class="btn register-btn">Register</button>
        </div>

        <div class="toggle-panel toggle-right">
            <h1>Welcome Back!</h1>
            <p>Already have an account?</p>
            <button class="btn login-btn">Login</button>
        </div>
    </div>
</div>

