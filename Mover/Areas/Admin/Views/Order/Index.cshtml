@using Mover.Areas.Admin.ViewModel.Order
@using Mover.Core.Enums.Roles
@using static Mover.Core.Enums.Orders.OrderStatus
@model List<OrderViewModel>

@{
    ViewData["Title"] = "Orders";
}

<style>
    .orders-container {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .filters-section {
        background: white;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .searchBar .loHead {
        font-size: 22px;
        font-weight: bold;
        color: #343a40;
        border-bottom: 2px solid #007bff;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }

    th {
        background-color: #007bff;
        color: white;
        text-align: center;
        padding: 10px;
    }

    td {
        text-align: center;
        vertical-align: middle;
        padding: 8px;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #004085;
        }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    #editOrderStatusModal .modal-content {
        background-color: white !important;
        color: black !important;
        border-radius: 8px;
        padding: 20px;
    }

    #editOrderStatusModal .modal-dialog {
        max-width: 500px;
    }

    .modal-backdrop {
        background-color: rgba(0, 0, 0, 0.5) !important;
    }
</style>

<div class="orders-container">
    <div class="filters-section">
        <div class="row">
            <div class="col-md-6">

            </div>
            <div class="col-md-3">
                <label for="filterOrderStatus" class="form-label">Order Status</label>
                <select class="form-control" id="filterOrderStatus" name="filterOrderStatus">
                    <option value="">--Select Status--</option>
                    @foreach (var ordestatus in ViewBag.OrderStatus)
                    {
                        <option value="@ordestatus.Value">@ordestatus.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-success w-45" id="searchBtn"><i class="fa fa-search"></i> Search</button>
            </div>

            <div class="searchBar">
                <div class="loHead">Orders</div>
            </div>

            <div id="orderGrid" class="panel" style="min-height:500px"></div>
        </div>
    </div>

    @* <div class="searchBar"> *@
    @*     <div class="loHead">Orders</div> *@
    @* </div> *@

    @* <div id="orderGrid" class="panel" style="min-height:500px"></div> *@
</div>

<div class="modal fade" id="editOrderStatusModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body text-center">
                <p>Loading...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Order/Order.js" asp-append-version="true"></script>

    <script>
        $(document).on('click', '.open-edit-modal', function () {
            var url = $(this).data('url');
            $('#editOrderStatusModal .modal-content').load(url, function () {
                $('#editOrderStatusModal').modal('show');
            });
        });
    </script>
}
