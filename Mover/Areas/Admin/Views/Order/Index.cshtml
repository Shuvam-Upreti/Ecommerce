@using Mover.Areas.Admin.ViewModel.Order
@using Mover.Core.Enums.Roles
@using static Mover.Core.Enums.Orders.OrderStatus
@model List<OrderViewModel>

@{
    ViewData["Title"] = "Orders";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Poppins", sans-serif;
    }

    .orders-container {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .filters-section {
        background: white;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .searchBar .loHead {
        font-size: 22px;
        font-weight: bold;
        color: #343a40;
        border-bottom: 2px solid #007bff;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }

    th {
        background-color: #007bff;
        color: white;
        text-align: center;
        padding: 10px;
    }

    td {
        text-align: center;
        vertical-align: middle;
        padding: 8px;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #004085;
        }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

    #editOrderStatusModal .modal-content {
        background-color: white !important;
        color: black !important;
        border-radius: 8px;
        padding: 20px;
    }

    #editOrderStatusModal .modal-dialog {
        max-width: 500px;
    }

    .modal-backdrop {
        background-color: rgba(0, 0, 0, 0.5) !important;
    }

    /* For Customer design */
    :root {
        --accent-color: #0eccb3;
        --cancel-btn-color: #ff7171;
    }

    .sidebar {
        width: 280px;
        border-right: 1px solid #eee;
        height: 100vh;
    }

    /*  .main-content {
            margin-left: 280px;
            } */

    .profile-img {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
    }

    .product-img {
        width: 80px;
        height: 80px;
        object-fit: cover;
    }

    .nav-link {
        color: #333;
        padding: 12px 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .nav-link:hover, .nav-link.active {
            background-color: #f8f9fa;
        }

    .search-box-order {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 8px 16px;
    }

    .filter-btn {
        background-color: #000;
        color: white;
        border-radius: 8px;
        padding: 8px 20px;
    }

    .view-order-btn {
        border: 1px solid #ddd;
        color: #333;
        background: white;
        padding: 6px 16px;
        border-radius: 6px;
    }

    .cancel-order-btn {
        background-color: var(--cancel-btn-color);
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
    }

    .review-btn {
        background-color: var(--accent-color);
        color: white;
        border: none;
        padding: 6px 16px;
        border-radius: 6px;
    }

    .status-pending {
        color: #3b82f6;
        background-color: #dbeafe;
        padding: 4px 12px;
        border-radius: 4px;
        display: inline-block;
    }

    .status-process, .status-approved {
        color: #eab308;
        background-color: #fef9c3;
        padding: 4px 12px;
        border-radius: 4px;
        display: inline-block;
    }

    .status-delivered {
        color: #22c55e;
        background-color: #dcfce7;
        padding: 4px 12px;
        border-radius: 4px;
        display: inline-block;
    }

    .status-returned {
        color: #dc2626;
        background-color: #fee2e2;
        padding: 4px 12px;
        border-radius: 4px;
        display: inline-block;
    }

    @@media (max-width: 991px) {
        .sidebar {
            width: 100%;
            height: auto;
            position: relative;
            border-right: none;
            border-bottom: 1px solid #eee;
        }

        .main-content {
            margin-left: 0;
        }
    }
</style>
@if (User.IsInRole(RolesEnum.Admin.ToString()))
{

    <div class="orders-container">
        <div class="filters-section">
            <div class="row">

                <div class="col-md-2 mb-3">
                    <label for="filterDateFrom" class="form-label">From</label>
                    <input type="date" class="form-control" id="filterDateFrom" max="@DateTime.Now.ToString("yyyy-MM-dd")" onchange="activateToDate()">
                </div>

                <div class="col-md-2 mb-3">
                    <label for="filterDateTo" class="form-label">To</label>
                    <input type="date" class="form-control" id="filterDateTo" disabled max="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>

                <div class="col-md-2">
                    <label for="filterOrderStatus" class="form-label">Order Status</label>
                    <select class="form-control" id="filterOrderStatus" name="filterOrderStatus">
                        <option value="">--Select Status--</option>
                        @foreach (var ordestatus in ViewBag.OrderStatus)
                        {
                            <option value="@ordestatus.Value">@ordestatus.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="searchInput" class="form-label">Search</label>
                    <input class="form-control" id="searchInputOrder" placeholder="Enter Name/Phone No." />
                </div>

                <div class="col-md-1 mb-3 d-flex align-items-end">
                    <button class="btn btn-success w-100" id="searchBtn">
                        <i class="fa fa-search"></i> Search
                    </button>
                </div>

                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100" id="createOrderBtn">
                        <i class="fa fa-plus"></i> Create Order
                    </button>
                </div>

                <div class="col-md-1 mb-3 d-flex align-items-end">
                    <button class="btn btn-secondary w-100" id="printSelectedRowsBtn">
                        <i class="fa fa-print"></i> Print
                    </button>
                </div>

                <!-- ✅ New Send to Logistics Button -->
        @*         <div class="col-md-2 mb-3 d-flex align-items-end">
                    <button class="btn btn-warning w-100" id="sendToLogisticsBtn">
                        <i class="fa fa-truck"></i> Send to Logistics
                    </button>
                </div> *@

                <div class="searchBar">
                    <div class="loHead">Orders</div>
                </div>

                <div id="orderGrid" class="panel" style="min-height:500px"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editOrderStatusModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-body text-center">
                    <p>Loading...</p>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="createOrderModal" tabindex="-1" role="dialog" aria-labelledby="createOrderLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createOrderLabel">Create Order</h5>

                </div>
                <div class="modal-body" id="createOrderContent">

                    <!-- Partial view content will be loaded here -->
                </div>
            </div>
        </div>
    </div>

}
else
{
    <div class="d-flex flex-column flex-lg-row">
        <!-- Sidebar -->
        <!-- Main Content -->
        <div class="main-content p-4 flex-grow-1">
            <div class="d-flex justify-content-betqween align-items-center mb-4">
                <h1 class="h4 mb-0">My Orders</h1>
                @*                     <div class="col-md-7">

                    </div>
                <div class="d-flex gap-3 align-items-center pull-right">
                    <div class="position-relative">
                        <i class="fa fa-search position-absolute" style="left: 12px; top: 50%; transform: translateY(-50%)"></i>
                        <input type="search" placeholder="Search" class="search-box-order ps-5">
                    </div>
                    <button class="filter-btn">
                        <i class="fa fa-sliders me-2"></i>
                        Filter
                    </button>
                </div> *@
            </div>

            <!-- Order Items -->
            <div class="d-flex flex-column gap-4">

                @*   @foreach (var order in Model)
                {
                    <div class="border rounded-3 p-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                            <div class="d-flex gap-3">
                                <img src="~/@order.OrderItemsViewModel.FirstOrDefault()?.ImageUrl" alt="@order.OrderItemsViewModel.FirstOrDefault()?.ProductName" class="product-img rounded-3">
                                <div>
                                    <h5>@order.OrderItemsViewModel.FirstOrDefault()?.ProductName</h5>
                                    <p class="text-muted mb-2">Qty: @order.OrderItemsViewModel.FirstOrDefault()?.Quantity</p>
                                    <span class="status-@order.OrderStatus.ToString().ToLower()">@order.OrderStatus</span>
                                    <p class="mt-2 mb-0">Your order is @order.OrderStatus.ToString().ToLower()</p>
                                </div>
                            </div>
                            <div class="d-flex flex-column align-items-end gap-2">
                                <h5>Rs. @order.OrderItemsViewModel.FirstOrDefault()?.PriceAtPurchase</h5>
                                <a href="/admin/order/details/@order.OrderId" class="view-order-btn">View Order</a>

                                @if (order.OrderStatus == OrderStatusEnums.Approved.ToString() || order.OrderStatus == OrderStatusEnums.Pending.ToString())
                                {
                                    <button class="cancel-order-btn">Cancel Order</button>
                                }
                            </div>
                        </div>
                    </div>
                }
 *@

                @foreach (var order in Model)
                {
                    <div class="order-container border rounded p-3 mb-3">
                        <div class="border rounded-3 p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                                <div class="d-flex gap-3">
                                    <button class="btn btn-sm btn-primary toggle-items" data-target="#order-items-@order.OrderId">+</button>

                                    <div>
                                        <h5>Order # @order.OrderId</h5>
                                        <p class="text-muted mb-2"> @order.OrderDate</p>
                                        <span class="status-@order.OrderStatus.ToString().ToLower()">@order.OrderStatus</span>
                                        <p class="mt-2 mb-0">Your order is @order.OrderStatus.ToString().ToLower()</p>
                                    </div>
                                </div>
                                <div class="d-flex flex-column align-items-end gap-2">
                                    <h5>Rs. @order.TotalAmount</h5>
                                    <a href="/admin/order/detailtest/@order.OrderId" class="view-order-btn" style="text-decoration:none;">View Order</a>

                                    @if (order.OrderStatus == OrderStatusEnums.Pending.ToString())
                                    {
                                        <form method="post" action="/admin/order/delete/@order.OrderId" style="display:inline;">
                                            <button type="submit" class="cancel-order-btn">Cancel Order</button>
                                        </form>
                                        @* <a href="/admin/order/delete/@order.OrderId" class="cancel-order-btn" style="text-decoration:none;">Cancel Order</a> *@
                                        @* <button class="cancel-order-btn">Cancel Order</button> *@
                                    }
                                    <span>Excluding delivery charges</span>
                                </div>
                            </div>
                        </div>
                        <!-- Order Items -->
                        <div id="order-items-@order.OrderId" class="order-items collapse mt-2">
                            <ul class="list-group">
                                @{
                                    var count = 1;
                                }
                                @foreach (var item in order.OrderItemsViewModel)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div class="d-flex gap-3">
                                            <img src="~/@item.ImageUrl" alt="@item.ProductName" class="product-img rounded-3" width="50" height="50">
                                            <div>
                                                <h6>Item: @count</h6>
                                                <h6>Name: @item.ProductName</h6>
                                                <p class="text-muted mb-0">Qty: @item.Quantity | Rs.@item.PriceAtPurchase</p>

                                            </div>
                                        </div>

                                        <span class="fw-bold">Rs. @(@item.PriceAtPurchase * @item.Quantity)</span>
                                    </li>
                                    count++;
                                }
                            </ul>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
}


@section Scripts {
    <script src="~/js/Order/Order.js" asp-append-version="true"></script>

    <script>
             $(document).ready(function () {
            $('#createOrderBtn').click(function () {
                $.ajax({
                    url: "/Admin/Order/CreateOrder",
                    type: 'GET',
                    success: function (result) {
                        $('#createOrderContent').html(result);
                        $('#createOrderModal').modal('show');
                    },
                    error: function () {
                        alert("Failed to load order creation form.");
                    }
                });
            });
        });
        $(document).on('click', '.open-edit-modal', function () {
            var url = $(this).data('url');
            $('#editOrderStatusModal .modal-content').load(url, function () {
                $('#editOrderStatusModal').modal('show');
            });
        });

             document.addEventListener("DOMContentLoaded", function() {
            document.querySelectorAll(".toggle-items").forEach(button => {
                button.addEventListener("click", function() {
                    let target = document.querySelector(this.getAttribute("data-target"));
                    if (target.classList.contains("show")) {
                        target.classList.remove("show");
                        this.textContent = "+";
                    } else {
                        target.classList.add("show");
                                     this.textContent = "-";
                    }
                });
            });
        });
    </script>
}
