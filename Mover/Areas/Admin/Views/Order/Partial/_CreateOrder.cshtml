@model Mover.ViewModel.Carts.SummaryViewModel

<style>
/* Modal Styling */
.modal {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.modal-dialog {
    max-width: 500px;
    margin: 1.75rem auto;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
}

.modal-content {
    background-color: #f9f9f9;
    border: none;
    border-radius: 10px;
    padding: 20px;
}

/* Close Button Styling */
.modal-header {
    border-bottom: none;
    padding-bottom: 0;
}

        /* Custom Close Button Styling */
        .modal-header .btn-close {
            background: none; /* Remove default close button background */
            border: none; /* Remove default border */
            font-size: 1.5rem; /* Adjust size of the Font Awesome icon */
            color: #333; /* Icon color */
            opacity: 1; /* Ensure full visibility */
            transition: transform 0.3s ease, color 0.3s ease; /* Smooth hover effects */
        }

            .modal-header .btn-close:hover {
                color: #ff6f61; /* Change color on hover */
                transform: scale(1.2); /* Slightly enlarge on hover */
            }

            .modal-header .btn-close::before {
                content: "\f00d"; /* Unicode for Font Awesome "fa-close" icon */
                font-family: "Font Awesome 6 Free"; /* Use Font Awesome font */
                font-weight: 900; /* Ensure the icon is bold (required for FA free version) */
            }

/* Form Styling */
#createOrderForm {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

#createOrderForm .form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

#createOrderForm label {
    font-weight: bold;
    color: #333;
}

#createOrderForm input,
#createOrderForm select {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 14px;
    transition: border-color 0.3s ease;
}

#createOrderForm input:focus,
#createOrderForm select:focus {
    border-color: #0eccb3;
    outline: none;
    box-shadow: 0 0 5px rgba(14, 204, 179, 0.5);
}

hr {
    border: none;
    border-top: 1px solid #ddd;
    margin: 20px 0;
}

h5 {
    font-size: 18px;
    color: #0eccb3;
    margin-bottom: 15px;
}

/* Submit Button Styling */
#createOrderForm button[type="submit"] {
    background-color: #0eccb3;
    color: white;
    border: none;
    padding: 10px;
    border-radius: 5px;
    font-size: 16px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

#createOrderForm button[type="submit"]:hover {
    background-color: #0096c7;
}
</style>

<form id="createOrderForm">
    <div class="form-group">
        <label>Select Product</label>
        <select class="form-control" id="productDropdown" name="CartViewModel[0].ProductId" required>
            <option value="">-- Select Product --</option>
            @for (int i = 0; i < Model.CartViewModel.Count; i++)
            {
                <option value="@Model.CartViewModel[i].ProductId"
                        data-price="@Model.CartViewModel[i].ProductPrice"
                        data-discount="@Model.CartViewModel[i].DiscountPercentage"
                        data-name="@Model.CartViewModel[i].ProductName">
                    @Model.CartViewModel[i].ProductName - Rs.@Model.CartViewModel[i].ProductPrice
                </option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <input type="number" class="form-control" name="CartViewModel[0].Quantity" value="1" min="1" required />
    </div>

    <!-- Hidden Inputs Bound to ViewModel -->
    <input type="hidden" name="CartViewModel[0].ProductPrice" id="productPrice" value="0" />
    <input type="hidden" name="CartViewModel[0].DiscountPercentage" id="productDiscount" value="0" />
    <input type="hidden" name="CartViewModel[0].ProductName" id="productName" />
    <input type="hidden" name="SummaryTotalPrice" id="summaryTotal" value="0" />

    <hr />
    <h5>Shipping Info</h5>

    <div class="form-group">
        <label>Phone Number</label>
        <input type="text" class="form-control" name="ShippingDetails.PhoneNumber" required />
    </div>

  @*   <div class="form-group">
        <label>Guest Email</label>
        <input type="email" class="form-control" name="ShippingDetails.GuestEmail" required />
    </div> *@

    <div class="form-group">
        <label>Shipping Address</label>
        <input type="text" class="form-control" name="ShippingDetails.ShippingAddressLine" required />
    </div>

    <button type="submit" class="btn btn-primary">Place Order</button>
</form>

<script>
    $('#productDropdown').on('change', function () {
        const selected = $(this).find(':selected');
        const price = selected.data('price');
        const discount = selected.data('discount');
        const name = selected.data('name');

        $('#productPrice').val(price);
        $('#productDiscount').val(discount);
        $('#productName').val(name);

        const qty = $('input[name="CartViewModel[0].Quantity"]').val();
        $('#summaryTotal').val(price * qty);
    });

    $('input[name="CartViewModel[0].Quantity"]').on('input', function () {
        const price = parseFloat($('#productPrice').val()) || 0;
        const qty = parseInt($(this).val()) || 1;
        $('#summaryTotal').val(price * qty);
    });

    $('#createOrderForm').submit(function (e) {
        e.preventDefault();
        const formData = $(this).serialize();

        $.ajax({
            type: "POST",
            url: "/Admin/Order/PlaceOrder",
            data: formData,
            success: function () {
                $('#createOrderModal').modal('hide');
                location.reload();
            },
            error: function () {
                alert('Error placing order.');
            }
        });
    });
</script>
