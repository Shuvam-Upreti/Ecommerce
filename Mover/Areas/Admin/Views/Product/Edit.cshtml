@model Mover.Areas.Admin.ViewModel.Product.ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<style>
    :root {
        --primary-color: #0ca98f;
        --text-color: #333;
        --background-light: #F9FAFC;
        --border-color: black;
        --input-bg: #FFFFFF;
        --shadow-color: rgba(0, 0, 0, 0.05);
    }

    body {
        background-color: var(--background-light);
        font-family: 'Arial', sans-serif;
        color: var(--text-color);
    }

    .form-container {
        max-width: 800px;
        margin: 50px auto;
        padding: 30px;
        background: white;
        border-radius: 8px;
        box-shadow: 0px 2px 8px var(--shadow-color);
        border: 1px solid var(--border-color);
    }

    .form-header {
        font-size: 1.8rem;
        font-weight: 700;
        text-align: center;
        color: var(--primary-color);
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding-bottom: 8px;
        border-bottom: 3px solid var(--primary-color);
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-control {
        border-radius: 6px;
        border: 1px solid var(--border-color);
        padding: 10px;
        font-size: 1rem;
        background-color: var(--input-bg);
        transition: all 0.2s ease-in-out;
    }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0px 0px 6px var(--primary-color);
        }

    .btn-custom {
        background: var(--primary-color);
        color: white;
        font-size: 0.9rem;
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.3s ease-in-out;
        font-weight: 600;
    }

        .btn-custom:hover {
            background: #0a8e76;
        }

    .image-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 15px;
    }

        .image-container img {
            border-radius: 6px;
            border: 1px solid var(--border-color);
        }
</style>

<div class="container form-container">
    <div class="form-header">Edit Product</div>
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" class="form-control" id="ProductId" name="ProductId" value="@Model.ProductId" />

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="ProductName">Product Name</label>
                    <input type="text" class="form-control" id="ProductName" name="ProductName" value="@Model.ProductName" required />
                </div>

                <div class="form-group">
                    <label for="OriginalPrice">Original Price</label>
                    <input type="number" class="form-control" id="OriginalPrice" name="OriginalPrice" value="@Model.OriginalPrice" required />
                </div>

                <div class="form-group">
                    <label for="DiscountedPrice">Discounted Price</label>
                    <input type="number" class="form-control" id="DiscountedPrice" name="DiscountedPrice" value="@Model.DiscountedPrice" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="Description">Description</label>
                    <textarea class="form-control" id="Description" name="Description">@Model.Description</textarea>
                </div>

                <div class="form-group">
                    <label for="DiscountPercentage">Discount Percentage</label>
                    <input type="number" class="form-control" id="DiscountPercentage" name="DiscountPercentage" value="@Model.DiscountPercentage" />
                </div>
                <div class="form-group">
                    <label for="InStock">In Stock</label>
                    <input type="number" class="form-control" id="InStock" name="InStock" value="@Model.InStock" />
                </div>
            </div>
        </div>

        <div class="form-group">
            <label for="Category">Category</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
                <option value="">--Select Category--</option>
            </select>
        </div>

        <div class="form-group">
            <label>Existing Images</label>
            <div class="image-container">
                @foreach (var imageUrl in Model.ImageUrls)
                {
                    <div>
                        <img src="~/@imageUrl" alt="Product Image" width="100" height="100" />
                        <label>
                            <input type="checkbox" name="DeleteImages" value="@imageUrl" /> Delete
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="form-group">
            <label for="Images">Upload New Images</label>
            <input type="file" class="form-control" id="Images" name="Images" multiple />
        </div>

        <div class="text-center mt-3">
            <button type="submit" class="btn btn-custom">Update Product</button>
        </div>
    </form>
</div>