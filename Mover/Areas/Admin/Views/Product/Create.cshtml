@using Mover.Areas.Admin.ViewModel.Product
@model ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<style>
    /* Theme Colors */
    :root {
        --primary-color: #0ca98f;
        --text-color: #333;
        --background-light: #F9FAFC;
        --border-color: black;
        --input-bg: #FFFFFF;
        --shadow-color: rgba(0, 0, 0, 0.1);
    }

    /* General Styles */
    body {
        background-color: var(--background-light);
        font-family: 'Arial', sans-serif;
        color: var(--text-color);
    }

    .form-container {
        max-width: 800px;
        margin: 50px auto;
        padding: 30px;
        background: white;
        border-radius: 10px;
        box-shadow: 0px 4px 12px var(--shadow-color);
        border: 1px solid var(--border-color);
    }

    .form-header {
        font-size: 1.8rem;
        font-weight: 700;
        text-align: center;
        color: var(--primary-color);
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding-bottom: 8px;
        border-bottom: 3px solid var(--primary-color);
    }

    /* Two-Column Layout */
    .form-group-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .full-width {
        grid-column: span 2;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-control {
        border-radius: 6px;
        border: 1px solid var(--border-color);
        padding: 10px;
        font-size: 1rem;
        background-color: var(--input-bg);
        transition: all 0.2s ease-in-out;
    }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0px 0px 6px var(--primary-color);
        }

    /* File Input */
    .form-control-file {
        border: 1px solid var(--border-color);
        padding: 8px;
        border-radius: 6px;
        background: var(--input-bg);
    }

    /* Button Styling */
    .btn-custom {
        background: var(--primary-color);
        color: white;
        font-size: 1rem;
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.3s ease-in-out;
        font-weight: 600;
    }

        .btn-custom:hover {
            background: #0a8e76;
        }

    .text-danger {
        font-size: 0.9rem;
    }
</style>

<div class="container form-container">
    <div class="form-header">Create a New Product</div>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="form-group-container">
            <!-- Left Column -->
            <div class="form-group">
                <label asp-for="ProductName">Product Name</label>
                <input asp-for="ProductName" class="form-control" placeholder="Enter product name" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
                    <option value="">Select Category</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <!-- Right Column -->
            <div class="form-group">
                <label asp-for="OriginalPrice">Original Price</label>
                <input asp-for="OriginalPrice" class="form-control" placeholder="Enter original price" />
                <span asp-validation-for="OriginalPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DiscountedPrice">Discounted Price</label>
                <input asp-for="DiscountedPrice" class="form-control" placeholder="Enter discounted price" />
                <span asp-validation-for="DiscountedPrice" class="text-danger"></span>
            </div>

            <!-- Discount Section -->
            <div class="form-group">
                <label asp-for="DiscountPercentage">Discount Percentage</label>
                <input asp-for="DiscountPercentage" class="form-control" placeholder="Enter discount percentage" />
                <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InStock">Stock Quantity</label>
                <input asp-for="InStock" class="form-control" placeholder="Enter stock quantity" />
                <span asp-validation-for="InStock" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsFeatured">Featured Product?</label>
                <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                <span asp-validation-for="IsFeatured" class="text-danger"></span>
            </div>
            <!-- Full Width Fields -->
            <div class="form-group full-width">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter product description"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group full-width">
                <label>Product Images</label>
                <input asp-for="Images" type="file" multiple class="form-control-file" />
                <span asp-validation-for="Images" class="text-danger"></span>
            </div>
        </div>

        <div class="text-center mt-3">
            <button type="submit" class="btn btn-custom">Create Product</button>
        </div>
    </form>
</div>
