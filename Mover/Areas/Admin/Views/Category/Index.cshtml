@using Mover.Areas.Admin.ViewModel.Category
@model List<CategoryViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Index";
}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Poppins", sans-serif;
    }
    #deleteCategoryModal {
        z-index: 1050; /* Make sure it's above other elements */
        display: block !important; /* Force display */
        background-color: rgba(0, 0, 0, 0.5); /* Semi-transparent background */
    }

        #deleteCategoryModal .modal-content {
            background-color: #000; /* Ensure the background color is visible */
            color: #000; /* Make sure the text is visible */
        }

    .category-container {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    } .filters-section {
        background: white;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .filters-section .loHead {
        font-size: 22px;
        font-weight: bold;
        color: #343a40;
        border-bottom: 2px solid #007bff;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }

    .btn-create-category {
        background-color: #0eccb3 !important;
        border-color: #0eccb3 !important;
        color: white !important;
    }

        .btn-create-category:hover {
            background-color: #0ca98f !important;
            border-color: #0ca98f !important;
        }
</style>
@Html.AntiForgeryToken()


