 *@
<div class="category-container">
    <div class="filters-section">
        <div class="row d-flex justify-content-between align-items-center">
            <!-- Products Heading -->
            <div class="col-md-6">
                <div class="loHead">Category</div>
            </div>


            <div class="col-md-6 d-flex justify-content-center">
                <a href="/admin/category/create" class="btn btn-success btn-create-category pull-right">
                    <i class="fa fa-plus"></i> Create New category
                </a>
            </div>
        </div>

        <div id="categoryGrid" class="panel" style="min-height:500px"></div>
    </div>
</div>


@section scripts {

    <script src="~/js/Category/Category.js" asp-append-version="true"></script>

}
