/* Hide the default number input arrows */
input[type=number]::-webkit-inner-spin-button,
input[type=number]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

input[type=number] {
    -moz-appearance: textfield; /* Hide arrows in Firefox */
}

/* Base container styles */
.container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: #f5f5f5;
    overflow: hidden; /* Prevent horizontal scroll during animation */
}

/* Form box base styles */
.form-box {
    position: relative;
    width: 100%;
    max-width: 400px;
    background: #fff;
    border-radius: 10px;
    padding: 30px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.6s ease-in-out, opacity 0.6s ease-in-out;
}

/* Input box base styles */
.input-box {
    position: relative;
    width: 100%;
    margin-bottom: 20px;
}

.input-box input {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-size: 16px;
}

.input-box i {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: #666;
}

/* Button base styles */
.btn {
    width: 100%;
    padding: 12px;
    background: #007bff;
    color: #fff;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    cursor: pointer;
}

.btn:hover {
    background: #0056b3;
}

/* Toggle box base styles */
.toggle-box {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
}

.toggle-panel {
    flex: 1;
    padding: 20px;
    text-align: center;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
}

/* Animation classes */
.container.active .form-box.login {
    transform: translateX(-100%);
    opacity: 0;
    pointer-events: none;
}

.container.active .form-box.register {
    transform: translateX(0);
    opacity: 1;
    pointer-events: all;
}

.form-box.register {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
}

/* Media Queries for Premium Responsive Design */
@media (max-width: 1200px) {
    .container {
        padding: 25px;
    }
    
    .form-box, .toggle-box {
        max-width: 450px;
    }
}

@media (max-width: 1024px) {
    .container {
        padding: 20px;
        min-height: 90vh;
    }

    .form-box, .toggle-box {
        max-width: 420px;
        padding: 25px;
    }

    .input-box input {
        padding: 14px 15px;
    }

    .btn {
        padding: 14px;
        font-weight: 500;
    }
}

@media (max-width: 768px) {
    .container {
        padding: 15px;
        flex-direction: column;
        align-items: center;
    }

    .form-box {
        width: 100%;
        max-width: 400px;
        margin-bottom: 20px;
    }

    .input-box {
        width: 100%;
    }

    .input-box input {
        width: 100%;
        padding: 12px 15px;
    }

    .toggle-box {
        width: 100%;
        max-width: 400px;
        flex-direction: column;
        gap: 15px;
    }

    .toggle-panel {
        width: 100%;
        margin: 0;
    }

    .input-box input:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
    }

    .input-box i {
        font-size: 18px;
        right: 15px;
        color: #666;
    }

    .btn {
        font-size: 15px;
        padding: 12px;
        border-radius: 8px;
        font-weight: 500;
        letter-spacing: 0.5px;
        background: linear-gradient(45deg, #007bff, #0056b3);
        box-shadow: 0 4px 15px rgba(0, 123, 255, 0.2);
    }

    .btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(0, 123, 255, 0.3);
    }

    h1 {
        font-size: 28px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #2c3e50;
    }

    p {
        font-size: 15px;
        color: #666;
        margin-bottom: 20px;
    }
}

@media (max-width: 480px) {
    .container {
        padding: 10px;
    }

    .form-box {
        padding: 20px;
        max-width: 100%;
    }

    .input-box input {
        padding: 10px 12px;
    }

    .toggle-box {
        padding: 15px;
    }

    h1 {
        font-size: 24px;
    }

    p {
        font-size: 14px;
    }
}

@media (max-width: 320px) {
    .container {
        padding: 8px;
    }

    .form-box {
        padding: 15px;
    }

    .input-box input {
        padding: 8px 10px;
    }

    h1 {
        font-size: 20px;
    }

    p {
        font-size: 13px;
    }
}

/* Touch Device Optimization */
@media (hover: none) and (pointer: coarse) {
    .form-box {
        transition: transform 0.3s ease;
    }
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
    .form-box {
        transition: none;
    }
}

/* Premium Dark Mode Support */
@media (prefers-color-scheme: dark) {
    .form-box, .toggle-panel {
        background: #1a1a1a;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.2);
    }

    .input-box input {
        background: #2d2d2d;
        border-color: #3d3d3d;
        color: #fff;
    }

    .input-box input:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.15);
    }

    .input-box i {
        color: #888;
    }

    h1 {
        color: #fff;
    }

    p {
        color: #aaa;
    }
}
